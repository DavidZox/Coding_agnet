--- a/all_your_base.cpp
+++ b/all_your_base.cpp
@@ -2,4 +2,34 @@
 
 namespace all_your_base {
 
+std::vector<unsigned int> convert(unsigned int from_base, const std::vector<unsigned int>& in_digits, unsigned int to_base) {
+    if (from_base < 2 || to_base < 2) {
+        throw std::invalid_argument("Bases must be at least 2");
+    }
+
+    unsigned long long value = 0;
+    bool all_zero = true;
+    for (unsigned int digit : in_digits) {
+        if (digit >= from_base) {
+            throw std::invalid_argument("Digit must be less than the base");
+        }
+        value = value * from_base + digit;
+        if (digit != 0) {
+            all_zero = false;
+        }
+    }
+
+    if (in_digits.empty() || all_zero) {
+        return {};
+    }
+
+    std::vector<unsigned int> result;
+    while (value > 0) {
+        result.insert(result.begin(), static_cast<unsigned int>(value % to_base));
+        value /= to_base;
+    }
+
+    return result;
+}
+
 }  // namespace all_your_base

