# 測試用的 makefile（評測產生）：自動收集 tests/*.cpp，跟正式程式（main.cpp 以外）一起連結 gtest 執行。
# make -f makefile_test test     建置並執行全部測試（GTEST 參數可以用 ARGS="--gtest_filter=..."）
# make -f makefile_test coverage 加上 coverage 旗標重新建置、執行，再用 gcovr 印出覆蓋率
CXX = g++
CC = gcc
CXXFLAGS ?= -std=c++17 -g -O0
INCLUDES = -Iinclude -I. 
PROD_SRCS = src/people_management.cpp src/utils.cpp
PROD_C_SRCS = 
TEST_SRCS = $(wildcard tests/*.cpp)
BUILD = build_test
PROD_OBJS = $(patsubst %.cpp,$(BUILD)/%.o,$(PROD_SRCS)) $(patsubst %.c,$(BUILD)/%.c.o,$(PROD_C_SRCS))
TEST_OBJS = $(patsubst %.cpp,$(BUILD)/%.o,$(TEST_SRCS))
LIBS = -lgtest -lgtest_main -pthread -lsqlite3
COV ?=

.PHONY: test coverage clean
test: $(BUILD)/run_tests
	./$(BUILD)/run_tests $(ARGS)

$(BUILD)/run_tests: $(PROD_OBJS) $(TEST_OBJS)
	$(CXX) $(CXXFLAGS) $(COV) -o $@ $^ $(LIBS)

$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(COV) $(INCLUDES) -MMD -MP -c -o $@ $<

$(BUILD)/%.c.o: %.c
	@mkdir -p $(dir $@)
	$(CC) -O0 $(INCLUDES) -c -o $@ $<

coverage:
	rm -rf $(BUILD)
	$(MAKE) -f makefile_test COV=--coverage test
	gcovr -r . --gcov-executable /usr/bin/gcov-11 --filter 'src/' --filter 'include/' --exclude-throw-branches --exclude-unreachable-branches --print-summary --txt

clean:
	rm -rf $(BUILD)

-include $(shell find $(BUILD) -name '*.d' 2>/dev/null)
